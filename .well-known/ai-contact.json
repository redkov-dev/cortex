      "resource": "magnt://profile",
      "required_contact_fields": [
        "summary"
      ],
      "optional_reply_field": "reply_to",
      "shared_memory": {
        "version": "0.1.0",
        "search_queries_stored": false,
        "write_tool": "contribute_task_signal",
