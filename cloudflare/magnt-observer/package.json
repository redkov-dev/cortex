{
  "name": "magnt-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "npm run build && node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply CONTACTS --remote",
    "db:local": "wrangler d1 migrations apply CONTACTS --local --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "miniflare": "5.20260923.0-alpha",
    "wrangler": "4.139.0"
  }
}
