{
  "name": "magnt-observer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:migrated": "npm run db:migrate && npm run deploy",
    "test": "npm run build:local && MAGNT_TEST_BUNDLE=dist-local node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "metrics": "node scripts/shared-memory-metrics.mjs",
    "db:migrate": "wrangler d1 migrations apply CONTACTS --remote",
    "db:local": "wrangler d1 migrations apply CONTACTS --local --config wrangler.local.jsonc",
    "build:local": "node scripts/build-local.mjs",
    "deploy:core": "node scripts/prepare-core-config.mjs && wrangler deploy --config wrangler.core.generated.json",
    "deploy:owner": "wrangler deploy --config wrangler.owner.jsonc",
    "deploy:public": "wrangler deploy --config wrangler.public.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260923.0-alpha",
    "wrangler": "4.139.0"
  }
}
