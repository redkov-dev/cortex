{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magnt-observer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "magnt_requests"
    }
  ]
}
