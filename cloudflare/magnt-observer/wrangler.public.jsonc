{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magnt-observer",
  "main": "src/public-gateway.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": [] },
  "routes": [
    { "pattern": "magnt.ru/*", "zone_name": "magnt.ru" },
    { "pattern": "www.magnt.ru/*", "zone_name": "magnt.ru" }
  ],
  "services": [{ "binding": "PUBLIC_CORE", "service": "magnt-core", "entrypoint": "PublicApi" }],
  "observability": { "enabled": true, "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } }
}
