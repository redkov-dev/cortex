{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magnt-owner-gateway",
  "main": "src/owner-gateway.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [{ "pattern": "owner.magnt.ru", "custom_domain": true }],
  "services": [{ "binding": "OWNER_CORE", "service": "magnt-core", "entrypoint": "OwnerApi" }],
  "ratelimits": [
    { "name": "OWNER_REQUEST_LIMIT", "namespace_id": "761001", "simple": { "limit": 180, "period": 60 } },
    { "name": "OWNER_LOGIN_LIMIT", "namespace_id": "761002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true, "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } }
}
